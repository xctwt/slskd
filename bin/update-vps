#!/usr/bin/env bash
# updates webseekd installed as a systemd service to the latest build, from the "qol-latest" release
# that .github/workflows/fork-build.yml publishes. run it on the server:
#
#   curl -fsSL https://raw.githubusercontent.com/xctwt/webseekd/main/bin/update-vps | sudo bash
#
# settings (environment variables):
#   SERVICE      systemd service name (default: webseekd, or slskd if there's no webseekd service)
#   INSTALL_DIR  folder holding the binary (default: read from the service)
#   REPO, TAG    where to download from (default: xctwt/webseekd, qol-latest)
#
# also updates an install of slskd, or of this fork from before it was renamed, whose service runs
# <INSTALL_DIR>/slskd: that file becomes a link to the new webseekd binary, so the service keeps working.
#
# the config file and data are left alone; the previous binaries are kept in <INSTALL_DIR>.previous
# and put back automatically if the new version doesn't start.
set -euo pipefail

if [ -z "${SERVICE:-}" ]; then
  if systemctl cat webseekd > /dev/null 2>&1; then SERVICE=webseekd; else SERVICE=slskd; fi
fi

REPO="${REPO:-xctwt/webseekd}"
TAG="${TAG:-qol-latest}"

fail() { echo "💥  $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || fail "run this as root (with sudo)"

case "$(uname -m)" in
  x86_64 | amd64) runtime=linux-x64 ;;
  aarch64 | arm64) runtime=linux-arm64 ;;
  *) fail "no build for $(uname -m); builds exist for x86_64 and aarch64" ;;
esac

if [ -z "${INSTALL_DIR:-}" ]; then
  # ExecStart looks like: { path=/opt/webseekd/webseekd ; argv[]=/opt/webseekd/webseekd --app-dir ... }
  executable=$(systemctl show -p ExecStart --value "$SERVICE" 2>/dev/null | sed -n 's/.*path=\([^ ;]*\).*/\1/p' | head -n 1)
  [ -n "$executable" ] || fail "couldn't find the '$SERVICE' service; set SERVICE or INSTALL_DIR"
  [[ "$executable" == */webseekd || "$executable" == */slskd ]] || fail "the '$SERVICE' service runs $executable, not a webseekd or slskd binary (Docker?); set INSTALL_DIR if this is right"
  INSTALL_DIR=$(dirname "$executable")
  binary=$(basename "$executable")
elif [ -e "$INSTALL_DIR/webseekd" ]; then
  binary=webseekd
else
  binary=slskd
fi

[ -x "$INSTALL_DIR/$binary" ] || fail "no $binary binary in $INSTALL_DIR"

# the folder gets backed up and its files replaced, so make sure it's an unpacked release and
# not somewhere shared like /usr/local/bin
[ -d "$INSTALL_DIR/wwwroot" ] || fail "$INSTALL_DIR doesn't look like an unpacked release (no wwwroot folder); not touching it"

owner=$(stat -L -c '%U:%G' "$INSTALL_DIR/$binary")
base="https://github.com/$REPO/releases/download/$TAG"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

echo "⬇️   downloading $runtime build from $REPO ($TAG)"
curl -fL --retry 3 -o "$work/webseekd-$runtime.tar.gz" "$base/webseekd-$runtime.tar.gz"
curl -fsSL --retry 3 -o "$work/SHA256SUMS" "$base/SHA256SUMS"
(cd "$work" && sha256sum --check --ignore-missing --quiet SHA256SUMS) || fail "checksum mismatch; not installing"

mkdir "$work/new"
tar -xzf "$work/webseekd-$runtime.tar.gz" -C "$work/new"
[ -x "$work/new/webseekd" ] || fail "the download has no webseekd binary"

echo "🛑  stopping $SERVICE"
systemctl stop "$SERVICE"

echo "📦  keeping the current version in $INSTALL_DIR.previous"
rm -rf "$INSTALL_DIR.previous"
cp -a "$INSTALL_DIR" "$INSTALL_DIR.previous"

# the web UI's file names change with every build, so replace it rather than copying over it
rm -rf "$INSTALL_DIR/wwwroot"
cp -a "$work/new/." "$INSTALL_DIR/"

if [ "$binary" = slskd ]; then
  # the service still starts <INSTALL_DIR>/slskd
  rm -f "$INSTALL_DIR/slskd"
  ln -s webseekd "$INSTALL_DIR/slskd"
fi

chown -R "$owner" "$INSTALL_DIR"

echo "▶️   starting $SERVICE"
systemctl start "$SERVICE"
sleep 15

if ! systemctl is-active --quiet "$SERVICE"; then
  echo "💥  $SERVICE didn't stay up; putting the previous version back" >&2
  journalctl -u "$SERVICE" -n 30 --no-pager >&2 || true
  systemctl stop "$SERVICE" || true
  # removed first so that copying the old files back doesn't write through the link
  rm -rf "$INSTALL_DIR/wwwroot" "$INSTALL_DIR/slskd" "$INSTALL_DIR/webseekd"
  cp -a "$INSTALL_DIR.previous/." "$INSTALL_DIR/"
  systemctl start "$SERVICE"
  exit 1
fi

echo "🎉  updated: $("$INSTALL_DIR/webseekd" --version 2>/dev/null | head -n 1 || echo "see the web UI for the version")"

if [ "$binary" = slskd ]; then
  echo "ℹ️   $SERVICE runs $INSTALL_DIR/slskd, which now links to webseekd. You can point ExecStart at $INSTALL_DIR/webseekd instead."
fi
